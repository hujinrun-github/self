  "temporary_viewport_reset": true,
  "production_user_drafts_modified": false,
  "production_checks": {
    "temporary_blank_page_fullscreen": true,
    "empty_save_notice": true,
    "escape_exit": true,
    "temporary_tab_closed": true,
    "user_original_tab_preserved": true,
